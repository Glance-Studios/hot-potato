{
  "schemaVersion": 1,
  "id": "hot-potato",
  "version": "${version}",
  "name": "Hot Potato",
  "description": "Server-side Hot Potato event: a random player gets a ticking potato - pass it by hitting someone, or explode. Players install nothing.",
  "authors": ["Glance Studios"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "server": [
      { "adapter": "kotlin", "value": "dev.hotpotato.HotPotatoMod" }
    ]
  },
  "mixins": [
    "hot-potato.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13"
  }
}
